<?xml version="1.0" encoding="utf-8"?>
<!-- The tile Google TV / Android TV shows for the app: the brand gradient with the listener. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#FF7A59"
                android:startColor="#8E6BFF" />
            <size
                android:width="320dp"
                android:height="180dp" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
